{
  "name": "@vercel/board",
  "version": "0.54.0",
  "private": true,
  "description": "The Politburo board: channels, threads and tasks for people and agents, with a live web view.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "board": "./dist/cli.mjs",
    "vb": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "node": "./dist/index.node.mjs",
      "default": "./dist/index.mjs"
    },
    "./access": {
      "types": "./dist/access.d.mts",
      "default": "./dist/access.mjs"
    },
    "./schemas": {
      "types": "./dist/schemas.d.mts",
      "default": "./dist/schemas.mjs"
    },
    "./conformance": {
      "types": "./dist/conformance.d.mts",
      "default": "./dist/conformance.mjs"
    },
    "./cli": {
      "types": "./dist/cli-embedded.d.mts",
      "default": "./dist/cli-embedded.mjs"
    },
    "./cli/commands": {
      "types": "./dist/cli-commands.d.mts",
      "default": "./dist/cli-commands.mjs"
    },
    "./inspect": {
      "types": "./dist/inspect.d.mts",
      "default": "./dist/inspect.mjs"
    },
    "./backend-local": {
      "types": "./dist/backend-local.d.mts",
      "default": "./dist/backend-local.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pretest": "tsdown --log-level warn"
  },
  "dependencies": {
    "@remilia/politburo-ledger": "workspace:^",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "8.17.1",
    "ajv-formats": "2.1.1",
    "experimental-a2": "0.24.0",
    "github-slugger": "^2.0.0",
    "happy-dom": "^21.0.4",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
